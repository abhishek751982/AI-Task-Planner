# ── Neon PostgreSQL (required) ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── Free LLM ──────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
LLM_API_KEY=gsk_your-groq-key-here
LLM_MODEL=llama-3.3-70b-versatile

# ── Todoist (recommended — works on Mac + iPhone, different Apple IDs OK) ─
TASKS_BACKEND=todoist
TODOIST_API_TOKEN=your-todoist-api-token
TODOIST_PROJECT_NAME=Guide Todoo
REMINDERS_MODE=off

# ── Apple Reminders (optional — only if TASKS_BACKEND=reminders) ──────────
# REMINDERS_MODE=local
# REMINDERS_LIST=Guide Todoo
# BRIDGE_SECRET=change-me
# BRIDGE_API_URL=https://your-app.vercel.app

# ── Vercel cron ───────────────────────────────────────────────────────────
CRON_SECRET=change-me-to-a-long-random-string

# ── Jira (optional) ───────────────────────────────────────────────────────
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your-jira-api-token

# ── Scheduler (local dev) ─────────────────────────────────────────────────
TIMEZONE=Asia/Kolkata
MAX_TASKS_PER_DAY=4
PLANNING_HORIZON_WEEKS=12
MORNING_PLAN_HOUR=8
EOD_SUMMARY_HOUR=20

# ── Google Calendar OAuth ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ai-based-task-planner.vercel.app/auth/google/callback
APP_BASE_URL=https://ai-based-task-planner.vercel.app

# ── Auth / webhooks ─────────────────────────────────────────────────────────
# Required for sign-in cookies. Use a long random string; do not leave the placeholder.
SESSION_SECRET=change-me-to-a-long-random-string
TODOIST_WEBHOOK_SECRET=
